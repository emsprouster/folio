{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let f=path.join('/Users/emmasprouster/Desktop/portfolio',req.url==='/'?'/index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end();}else{const ext=path.extname(f);const m={'html':'text/html','svg':'image/svg+xml','css':'text/css','js':'application/javascript','png':'image/png','jpg':'image/jpeg'}[ext.slice(1)]||'application/octet-stream';res.writeHead(200,{'Content-Type':m});res.end(d);}});}).listen(4322)"],
      "port": 4322
    }
  ]
}
